SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=mineria_datos_2026b
SQLSERVER_USER=TU_USUARIO
SQLSERVER_PASSWORD=TU_PASSWORD


# ------------------------------------------------------------
# RUTAS DEL PROYECTO
# Usar rutas relativas, no rutas personales de Windows.
